{
  "name": "niktayv-11a",
  "version": "1.1.0",
  "description": "Personal Eleventy site for Yuri Vyatkin, built with Tailwind CSS and Alpine.js",
  "author": "Yuri Vyatkin",
  "license": "MIT",
  "homepage": "https://niktayv.com",
  "keywords": [
    "eleventy",
    "tailwindcss",
    "alpinejs",
    "cloudflare-workers",
    "static-site"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev:eleventy": "eleventy --serve",
    "dev:css": "mkdirp dist/assets && postcss src/assets/css/tailwind.css -o dist/assets/tailwind.css --watch",
    "dev:css:once": "mkdirp dist/assets && postcss src/assets/css/tailwind.css -o dist/assets/tailwind.css",
    "dev": "npm run clean && npm run dev:css:once && concurrently \"npm:dev:css\" \"npm:dev:eleventy\"",
    "build:eleventy": "cross-env ELEVENTY_ENV=production eleventy",
    "build:css": "mkdirp dist/assets && cross-env NODE_ENV=production postcss src/assets/css/tailwind.css -o dist/assets/tailwind.css",
    "build": "npm run clean && npm run build:css && npm run build:eleventy",
    "cf:check-env": "node scripts/validate-cloudflare-build-env.js",
    "cf:build": "npm run cf:check-env && npm run build",
    "cf:dev": "npm run cf:build && wrangler dev --local --port 8787 --ip 127.0.0.1",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/postcss": "^4.1.12",
    "alpinejs": "^3.15.0",
    "clean-css": "^4.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^8.2.0",
    "eleventy-plugin-svg-sprite": "^2.4.5",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.1",
    "markdown-it-emoji": "^1.4.0",
    "mkdirp": "^3.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "rimraf": "^6.1.3",
    "slugify": "^1.4.6",
    "tailwindcss": "^4.1.12",
    "wrangler": "^4.92.0"
  }
}
