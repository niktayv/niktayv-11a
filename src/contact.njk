---
title: Contact
date: 2020-08-05
layout: page
eleventyNavigation:
  key: main
  title: Contact  # as it will appear in the nav
  order: 4        # order to display in the nav
seo:
  title: Contact Us!
  description: Use this handy form to contact us.
---

<div class="relative bg-white">
  <div class="relative mx-auto max-w-7xl lg:grid lg:grid-cols-5">
    <div class="px-4 py-4 bg-gray-50 sm:px-6 lg:col-span-2 lg:px-8 lg:py-8 xl:pr-12">
      <div class="max-w-lg mx-auto">
        <h2 class="text-3xl font-extrabold leading-8 tracking-tight text-gray-600 sm:text-3xl sm:leading-9">
          Get in touch
        </h2>
        <p class="mt-3 text-lg leading-6 text-gray-500">
          This contact form is served as static HTML and submitted to the Cloudflare Worker endpoint at <code>/api/contact</code>.
          <br><br>
          The address info below is managed in <code>src/_data/meta.js</code>.
          <br><br>
          Note the difference in <code>address.phoneDisplay</code> and <code>address.phoneCall</code> to ensure mobile users will be able to correctly dial just by pressing the phone link.
        </p>
        <dl class="mt-8 text-base leading-6 text-gray-500">
          <div>
            <dt class="sr-only">Postal address</dt>
            <dd>
              <p>{{ meta.address.street }}</p>
              <p>{{ meta.address.city }}, {{ meta.address.state }}
                {{ meta.address.zip }}</p>
            </dd>
          </div>
          <div class="mt-6">
            <dt class="sr-only">Phone number</dt>
            <dd class="flex">
              <svg class="flex-shrink-0 w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span class="ml-3">
                <a class="hover:underline" href="tel:{{ meta.address.phoneCall }}">{{ meta.address.phoneDisplay }}</a>
              </span>
            </dd>
          </div>
          <div class="mt-3">
            <dt class="sr-only">Email</dt>
            <dd class="flex">
              <svg class="flex-shrink-0 w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span class="ml-3">
                <a class="hover:underline" href="mailto:{{ meta.address.email }}">{{ meta.address.email }}</a>
              </span>
            </dd>
          </div>
        </dl>
      </div>
    </div>
    <div class="px-4 py-16 bg-white sm:px-6 lg:col-span-3 lg:py-24 lg:px-8 xl:pl-12">
      <div class="max-w-lg mx-auto lg:max-w-none">
        <div id="contact-form-status" class="hidden p-4 mb-6 border rounded-lg" role="status" aria-live="polite"></div>
        <form name="contact" action="/api/contact" method="POST" class="grid grid-cols-1 gap-y-6">
          <div>
            <label for="full_name" class="sr-only">Full name</label>
            <div class="relative rounded-md shadow-sm">
              <input id="full_name" name="name" class="form-input" placeholder="Full name" required>
            </div>
          </div>
          <div>
            <label for="email" class="sr-only">Email</label>
            <div class="relative rounded-md shadow-sm">
              <input id="email" name="email" type="email" class="form-input" placeholder="Email" required>
            </div>
          </div>
          <div>
            <label for="phone" class="sr-only">Phone</label>
            <div class="relative rounded-md shadow-sm">
              <input id="phone" name="phone" class="form-input" placeholder="Phone">
            </div>
          </div>
          <div>
            <label for="message" class="sr-only">Message</label>
            <div class="relative rounded-md shadow-sm">
              <textarea id="message" name="message" rows="4" class="form-input" placeholder="Message" required></textarea>
            </div>
          </div>
          {% if build.turnstileSiteKey %}
          <div class="cf-turnstile" data-sitekey="{{ build.turnstileSiteKey }}" data-action="contact"></div>
          {% else %}
          <div class="p-4 text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg">
            Turnstile is not configured for this build. Set <code>TURNSTILE_SITE_KEY</code> before running the Cloudflare preview or deploy scripts.
          </div>
          {% endif %}
          <div>
            <span class="inline-flex rounded-md shadow-sm">
              <button type="submit" class="py-4 px-6 my-4 rounded-lg {{ colors.buttonDefault.text or colors.buttonCustom.text }} hover:{{ colors.buttonDefault.textHover or colors.buttonCustom.textHover }} {{ colors.buttonDefault.bg or colors.buttonCustom.bg }} hover:{{ colors.buttonDefault.bgHover or colors.buttonCustom.bgHover }} {{ colors.buttonDefault.border or colors.buttonCustom.border }}">
                Submit
              </button>
            </span>
          </div>
        </form>
        <div class="p-4 italic text-gray-600 bg-indigo-100 border border-indigo-300 rounded-lg">Submissions are protected by Cloudflare Turnstile and delivered by the Worker configured in <code>worker/index.js</code>. Keep the build environment and Worker bindings aligned before testing this page.</div>
      </div>
    </div>
  </div>
</div>

{% if build.turnstileSiteKey %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
<script>
  (() => {
    const statusBanner = document.getElementById('contact-form-status');
    if (!statusBanner) {
      return;
    }

    const status = new URLSearchParams(window.location.search).get('status');
    if (!status) {
      return;
    }

    const messages = {
      invalid: 'Please complete the Turnstile check again and resubmit the form.',
      error: 'We could not send your message. Please try again in a moment.',
      success: 'Your message was sent successfully.',
    };

    const toneClasses = {
      invalid: ['text-red-700', 'bg-red-50', 'border-red-200'],
      error: ['text-red-700', 'bg-red-50', 'border-red-200'],
      success: ['text-green-700', 'bg-green-50', 'border-green-200'],
    };

    const nextTone = toneClasses[status] || toneClasses.error;
    statusBanner.classList.add(...nextTone);
    statusBanner.textContent = messages[status] || messages.error;
    statusBanner.classList.remove('hidden');
  })();
</script>
